# Basic-auth password for the board (any username). Strongly recommended.
BOARD_PASSWORD=change-me
# Public/LAN URL of the board, used for links in Telegram messages.
BOARD_URL=http://burndown.lan:8088

# Telegram: create a bot with @BotFather, paste the token, then send /start to it.
TELEGRAM_BOT_TOKEN=
# Optional: pin the chat id. If empty, the first chat that sends /start is linked.
TELEGRAM_CHAT_ID=

# Daily alerts (24h). First = morning plan, last = evening check. Editable in Settings too.
ALERT_TIMES=09:00,21:00
TIMEZONE=Asia/Kolkata
